{
  "name": "@mediabridge-solutions/carrier-icons",
  "version": "0.1.2",
  "description": "Platform-agnostic, lightweight vector icons, brand color palettes, tracking URLs, and metadata for shipping carriers and freight logistics providers.",
  "author": "Mediabridge Solutions",
  "license": "MIT",
  "homepage": "https://mediabridge.solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediabridge-solutions/carrier-icons.git"
  },
  "bugs": {
    "url": "https://github.com/mediabridge-solutions/carrier-icons/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "shipping",
    "carrier",
    "logistics",
    "carrier-icons",
    "shipping-icons",
    "parcel",
    "freight",
    "dhl",
    "dpd",
    "ups",
    "fedex",
    "svg-icons"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-docs.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test": "node --test test/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.0"
  }
}
